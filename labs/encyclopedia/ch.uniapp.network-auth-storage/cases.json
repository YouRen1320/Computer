    "logText": "request fail",
    "storage": { "schemaVersion": 1, "validJson": true },
    "expected": "REQUEST_DOMAIN_NOT_ALLOWLISTED"
  },
  {
    "name": "production-build-uses-test",
    "environment": "production",
    "apiOrigin": "https://test-api.example.invalid",
