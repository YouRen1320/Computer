{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/publication-accessibility-toolchain.schema.json",
  "title": "FactoryCare P9 publication accessibility toolchain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "toolchain_id", "scope", "observed_on",
    "evidence_classification", "promotion_policy", "network_policy",
    "contract", "tools"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "toolchain_id": { "const": "p9-publication-accessibility" },
    "scope": { "const": "macos-arm64-local-observation" },
    "observed_on": { "type": "string", "format": "date" },
    "evidence_classification": { "const": "machine-only-not-certification" },
    "promotion_policy": { "const": "forbidden-without-human-review" },
    "network_policy": { "const": "forbidden-by-contract-not-os-enforced" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_count", "artifacts_by_format", "check_count", "checks_by_engine",
        "axe_rule_tags", "default_timeout_seconds", "transient_tool_output_limit_bytes"
      ],
      "properties": {
        "artifact_count": { "const": 307 },
        "artifacts_by_format": { "$ref": "#/$defs/artifact_counts" },
        "check_count": { "const": 324 },
        "checks_by_engine": { "$ref": "#/$defs/check_counts" },
        "axe_rule_tags": {
          "const": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22a", "wcag22aa"]
        },
        "default_timeout_seconds": { "const": 600 },
        "transient_tool_output_limit_bytes": { "const": 268435456 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "artifact_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["html", "epub", "pdf"],
      "properties": {
        "html": { "const": 273 },
        "epub": { "const": 17 },
        "pdf": { "const": 17 }
      }
    },
    "check_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axe-core", "epubcheck", "ace", "verapdf"],
      "properties": {
        "axe-core": { "const": 273 },
        "epubcheck": { "const": 17 },
        "ace": { "const": 17 },
        "verapdf": { "const": 17 }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "role", "resolver", "environment_variable", "executable",
        "version_arguments", "expected_version_prefix", "parser", "formats",
        "checks_per_artifact", "note"
      ],
      "properties": {
        "id": { "enum": ["axe-core", "epubcheck", "ace", "verapdf", "chrome", "chromedriver"] },
        "role": { "enum": ["audit-engine", "runtime-dependency"] },
        "resolver": { "enum": ["path", "env-directory", "env-file"] },
        "environment_variable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
        "executable": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$" },
        "version_arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^[-a-zA-Z0-9.]{1,40}$" }
        },
        "expected_version_prefix": { "type": "string", "pattern": "^[^\\r\\n]{1,160}$" },
        "parser": {
          "enum": [
            "axe-cli-json-v1", "epubcheck-json-v5", "ace-report-json-v1",
            "verapdf-json-v1", "not-applicable"
          ]
        },
        "formats": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["html", "epub", "pdf"] }
        },
        "checks_per_artifact": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
