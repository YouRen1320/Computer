{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/publication-profile-v2.schema.json",
  "title": "FactoryCare internal complete publication profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "profile_id", "edition", "publication_mode", "visibility",
    "language", "distribution_allowed", "source_date_epoch", "selection", "products",
    "target_formats", "toolchain_lock", "companion_inventory", "resource_policy", "notice"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "profile_id": { "const": "internal-complete" },
    "edition": { "type": "string", "minLength": 1 },
    "publication_mode": { "const": "internal-complete-preview" },
    "visibility": { "const": "internal" },
    "language": { "const": "zh-CN" },
    "distribution_allowed": { "const": false },
    "source_date_epoch": { "type": "integer", "minimum": 0 },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expected_chapter_count", "expected_volume_ids", "expected_status_counts"],
      "properties": {
        "kind": { "const": "catalog-all" },
        "expected_chapter_count": { "const": 255 },
        "expected_volume_ids": {
          "const": ["00", "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12", "13", "14", "15"]
        },
        "expected_status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drafting", "review", "verified"],
          "properties": {
            "drafting": { "type": "integer", "minimum": 0 },
            "review": { "type": "integer", "minimum": 0 },
            "verified": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "products": { "const": ["site", "whole-book", "per-volume"] },
    "target_formats": { "const": ["html", "epub", "pdf"] },
    "toolchain_lock": { "const": "publication/toolchain.yml" },
    "companion_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "presentation", "roots"],
      "properties": {
        "source": { "const": "git-tracked-only" },
        "presentation": { "const": "digest-index-only" },
        "roots": { "const": ["examples/encyclopedia", "labs/encyclopedia", "exercises/encyclopedia"] }
      }
    },
    "resource_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_network", "remote_resources", "allowed_local_schemes"],
      "properties": {
        "build_network": { "const": "forbidden" },
        "remote_resources": { "const": "link-only" },
        "allowed_local_schemes": { "const": ["file", "data"] }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "placements", "robots"],
      "properties": {
        "text": { "type": "string", "minLength": 16 },
        "placements": { "const": ["document-title", "document-opening", "metadata"] },
        "robots": { "const": "noindex,nofollow" }
      }
    }
  }
}
