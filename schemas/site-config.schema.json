{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/site-config.schema.json",
  "title": "FactoryCare encyclopedia site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "title",
    "edition",
    "language",
    "catalog",
    "version_registry",
    "output",
    "publish_statuses",
    "preview_statuses",
    "formats"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "site_id": { "const": "factorycare-encyclopedia" },
    "title": { "type": "string", "minLength": 1 },
    "edition": { "type": "string", "minLength": 1 },
    "language": { "const": "zh-CN" },
    "catalog": { "const": "curriculum/catalog.yml" },
    "version_registry": { "const": "versions/registry.yml" },
    "output": {
      "type": "string",
      "pattern": "^site/[a-zA-Z0-9._/-]+$"
    },
    "publish_statuses": { "const": ["verified"] },
    "preview_statuses": { "const": ["review"] },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["static-json", "static-html-shell"] }
    }
  }
}
