{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/publication-profile.schema.json",
  "title": "FactoryCare publication profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "edition",
    "publication_mode",
    "visibility",
    "language",
    "distribution_allowed",
    "source_date_epoch",
    "chapter_ids",
    "drafting_allowlist",
    "target_formats",
    "toolchain_lock",
    "resource_policy",
    "notice"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "edition": { "type": "string", "minLength": 1 },
    "publication_mode": { "const": "internal-preview" },
    "visibility": { "const": "internal" },
    "language": { "const": "zh-CN" },
    "distribution_allowed": { "const": false },
    "source_date_epoch": { "type": "integer", "minimum": 0 },
    "chapter_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "drafting_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "target_formats": {
      "const": ["html", "epub", "pdf"]
    },
    "toolchain_lock": {
      "const": "publication/toolchain.yml"
    },
    "resource_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_network", "remote_resources", "allowed_local_schemes"],
      "properties": {
        "build_network": { "const": "forbidden" },
        "remote_resources": { "const": "link-only" },
        "allowed_local_schemes": { "const": ["file", "data"] }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "placements", "robots"],
      "properties": {
        "text": { "type": "string", "minLength": 8 },
        "placements": {
          "const": ["document-title", "document-opening", "metadata"]
        },
        "robots": { "const": "noindex,nofollow" }
      }
    }
  }
}
