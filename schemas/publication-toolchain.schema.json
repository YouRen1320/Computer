{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/publication-toolchain.schema.json",
  "title": "FactoryCare publication toolchain observations and deferred locks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "toolchain_id",
    "scope",
    "observed_on",
    "tools"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "toolchain_id": { "const": "p3-publication" },
    "scope": { "const": "macos-arm64-p3" },
    "observed_on": { "type": "string", "format": "date" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "required_from",
        "command",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "state": { "enum": ["observed-current", "deferred"] },
        "required_from": { "enum": ["R1-A", "R1-B", "R2", "R3"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_version_prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]{1,160}$"
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "observed-current" } },
            "required": ["state"]
          },
          "then": { "required": ["expected_version_prefix"] }
        }
      ]
    }
  }
}
