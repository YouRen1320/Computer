{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/publication-plan.schema.json",
  "title": "FactoryCare deterministic publication sidecar plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "profile_id",
    "site_id",
    "edition",
    "publication_mode",
    "visibility",
    "distribution_allowed",
    "language",
    "deterministic",
    "generated_by",
    "output_root",
    "source_date_epoch",
    "resource_policy",
    "notice",
    "digest_algorithm",
    "profile",
    "catalog",
    "p2_baseline",
    "toolchain_lock",
    "tool_requirements",
    "chapters",
    "inputs",
    "input_count",
    "content_input_digest",
    "publisher_input_digest",
    "build_input_digest",
    "planned_outputs",
    "security"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": {
      "type": "string",
      "pattern": "^publication-plan\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "site_id": { "const": "factorycare-encyclopedia" },
    "edition": { "type": "string", "minLength": 1 },
    "publication_mode": { "const": "internal-preview" },
    "visibility": { "const": "internal" },
    "distribution_allowed": { "const": false },
    "language": { "const": "zh-CN" },
    "deterministic": { "const": true },
    "generated_by": { "const": "scripts/build-publication-plan.rb" },
    "output_root": {
      "type": "string",
      "pattern": "^build/publication/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source_date_epoch": { "type": "integer", "minimum": 0 },
    "resource_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_network", "remote_resources", "allowed_local_schemes"],
      "properties": {
        "build_network": { "const": "forbidden" },
        "remote_resources": { "const": "link-only" },
        "allowed_local_schemes": { "const": ["file", "data"] }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "placements", "robots"],
      "properties": {
        "text": { "type": "string", "minLength": 8 },
        "placements": { "const": ["document-title", "document-opening", "metadata"] },
        "robots": { "const": "noindex,nofollow" }
      }
    },
    "digest_algorithm": { "const": "sha256-path-nul-bytes-nul-v1" },
    "profile": { "$ref": "#/$defs/path_digest" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_sha256", "selected_projection_sha256"],
      "properties": {
        "path": { "const": "curriculum/catalog.yml" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "selected_projection_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "p2_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "manifest_schema_version",
        "digest_algorithms",
        "input_digests",
        "input_counts",
        "file_count"
      ],
      "properties": {
        "manifest_path": { "const": "site/generated/publication-manifest.json" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_schema_version": { "const": 3 },
        "digest_algorithms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "total"],
          "properties": {
            "category": { "const": "sha256-path-nul-content-sha256-nul-v1" },
            "total": { "const": "sha256-category-nul-digest-nul-v1" }
          }
        },
        "input_digests": { "$ref": "#/$defs/p2_input_digests" },
        "input_counts": { "$ref": "#/$defs/p2_input_counts" },
        "file_count": { "const": 5 }
      }
    },
    "toolchain_lock": { "$ref": "#/$defs/path_digest" },
    "tool_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tool_requirement" }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/input" }
    },
    "input_count": { "type": "integer", "minimum": 1 },
    "content_input_digest": { "$ref": "#/$defs/sha256" },
    "publisher_input_digest": { "$ref": "#/$defs/sha256" },
    "build_input_digest": { "$ref": "#/$defs/sha256" },
    "planned_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/planned_output" }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "private_path_count",
        "private_canary_count",
        "absolute_repository_path_count",
        "symlink_input_count"
      ],
      "properties": {
        "private_path_count": { "const": 0 },
        "private_canary_count": { "const": 0 },
        "absolute_repository_path_count": { "const": 0 },
        "symlink_input_count": { "const": 0 }
      }
    }
  },
  "$defs": {
    "p2_input_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "audit_security", "build_control", "total"],
      "properties": {
        "content": { "$ref": "#/$defs/sha256" },
        "audit_security": { "$ref": "#/$defs/sha256" },
        "build_control": { "$ref": "#/$defs/sha256" },
        "total": { "$ref": "#/$defs/sha256" }
      }
    },
    "p2_input_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "audit_security", "build_control", "total"],
      "properties": {
        "content": { "type": "integer", "minimum": 0 },
        "audit_security": { "type": "integer", "minimum": 0 },
        "build_control": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "repository_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(?:/(?:[a-zA-Z0-9_][a-zA-Z0-9._-]*|\\.gitignore))*$"
    },
    "output_path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(?:/[a-zA-Z0-9_][a-zA-Z0-9._-]*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "tool_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "required_from", "command", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["observed-current", "deferred"] },
        "required_from": { "enum": ["R1-A", "R1-B", "R2", "R3"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_version_prefix": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]{1,160}$"
        },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "observed-current" } },
            "required": ["state"]
          },
          "then": { "required": ["expected_version_prefix"] }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "source_path",
        "media_type",
        "presentation",
        "target_formats",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["example-source", "lab-source", "exercise-source", "runner-support", "oracle"]
        },
        "source_path": { "$ref": "#/$defs/repository_path" },
        "media_type": { "type": "string", "minLength": 1 },
        "presentation": { "enum": ["listing", "download"] },
        "target_formats": { "const": ["html", "epub", "pdf"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "volume",
        "order",
        "status",
        "source_path",
        "source_sha256",
        "public_artifact_manifest",
        "artifacts"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "volume": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["drafting", "review", "verified"] },
        "source_path": { "$ref": "#/$defs/repository_path" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "public_artifact_manifest": { "$ref": "#/$defs/path_digest" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "scope", "role", "sha256", "size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "scope": { "enum": ["content", "publisher-contract"] },
        "role": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "planned_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "format", "distribution"],
      "properties": {
        "path": { "$ref": "#/$defs/output_path" },
        "kind": {
          "enum": ["canonical-ast", "html-index", "chapter-html", "epub", "print-html", "pdf-candidate", "output-manifest"]
        },
        "format": { "enum": ["internal", "html", "epub", "pdf"] },
        "distribution": { "enum": ["internal", "internal-review-candidate"] }
      }
    }
  }
}
