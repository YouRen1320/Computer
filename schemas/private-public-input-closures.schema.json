{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/private-public-input-closures.schema.json",
  "title": "FactoryCare private recipe public input closures",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "visibility",
    "path_policy",
    "recipe_count",
    "recipes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "inventory_id": { "const": "verification.private-public-input-closures" },
    "visibility": { "const": "internal-only" },
    "path_policy": { "const": "exact-public-encyclopedia-regular-files-only" },
    "recipe_count": { "type": "integer", "minimum": 1 },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chapter_id", "inputs"],
        "properties": {
          "chapter_id": {
            "type": "string",
            "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "mode"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?:examples|labs|exercises)/encyclopedia/ch\\.[a-z0-9.-]+/[a-zA-Z0-9_][a-zA-Z0-9._-]*(?:/[a-zA-Z0-9_][a-zA-Z0-9._-]*)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mode": {
                  "type": "string",
                  "pattern": "^0[4567][0-7]{2}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
