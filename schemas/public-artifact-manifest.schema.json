{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/public-artifact-manifest.schema.json",
  "title": "FactoryCare per-chapter public artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "edition",
    "chapter_id",
    "chapter_path",
    "managed_roots",
    "artifacts",
    "repository_metadata"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": {
      "type": "string",
      "pattern": "^public-artifacts\\.ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "edition": { "type": "string", "minLength": 1 },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "chapter_path": {
      "type": "string",
      "pattern": "^book/volume-[0-9]{2}-[a-z0-9-]+/chapters/ch\\.[a-z0-9.-]+\\.md$"
    },
    "managed_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:examples|labs|exercises)/encyclopedia/ch\\.[a-z0-9.-]+$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "repository_metadata": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:examples|labs|exercises)/encyclopedia/ch\\.[a-z0-9.-]+/(?:[a-zA-Z0-9._-]+/)*\\.gitignore$"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "source_path",
        "media_type",
        "presentation",
        "target_formats"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "role": {
          "enum": [
            "example-source",
            "lab-source",
            "exercise-source",
            "runner-support",
            "oracle"
          ]
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?:examples|labs|exercises)/encyclopedia/ch\\.[a-z0-9.-]+/[a-zA-Z0-9_][a-zA-Z0-9._-]*(?:/[a-zA-Z0-9_][a-zA-Z0-9._-]*)*$"
        },
        "media_type": {
          "enum": [
            "text/markdown",
            "text/x-java-source",
            "text/x-shellscript",
            "text/plain",
            "application/xml"
          ]
        },
        "presentation": { "enum": ["listing", "download"] },
        "target_formats": { "const": ["html", "epub", "pdf"] }
      }
    }
  }
}
