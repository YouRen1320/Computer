{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/observed-verification-candidates-v2.schema.json",
  "title": "FactoryCare observed unreviewed verification candidates v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_catalog_id", "generated_by", "status", "evidence_class",
    "promotion_status", "candidate_count", "endpoint_count", "mechanical_gap_candidate_count",
    "mechanical_gap_candidate_ids", "mechanical_gap_endpoint_count", "mechanical_gap_endpoint_ids",
    "warning", "tool_probes", "candidates", "source_endpoint_report_sha256", "endpoint_observation_set_sha256"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "candidate_catalog_id": { "const": "p9-d5-observed-unreviewed-candidates-v2" },
    "generated_by": { "const": "scripts/generate-verification-manifests.rb --bootstrap-candidates --endpoint-report" },
    "status": {
      "enum": ["observed-unreviewed-candidate-v2", "observed-unreviewed-candidate-v2-with-mechanical-gaps"]
    },
    "evidence_class": { "const": "machine-only-not-learner-evidence" },
    "promotion_status": { "const": "forbidden-without-human-review" },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "endpoint_count": { "type": "integer", "minimum": 0 },
    "mechanical_gap_candidate_count": { "type": "integer", "minimum": 0 },
    "mechanical_gap_candidate_ids": { "$ref": "#/$defs/chapter_ids" },
    "mechanical_gap_endpoint_count": { "type": "integer", "minimum": 0 },
    "mechanical_gap_endpoint_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^ch\\.[a-z0-9.-]+:(?:example|exercise|lab)$" }
    },
    "warning": { "type": "string", "minLength": 1 },
    "tool_probes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/tool_probe" } },
    "candidates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/candidate" } },
    "source_endpoint_report_sha256": { "$ref": "#/$defs/sha256" },
    "endpoint_observation_set_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chapter_id": { "type": "string", "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "chapter_ids": {
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/chapter_id" }
    },
    "argv": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "tool_probe": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "version_argv", "status", "timed_out", "exit_code", "observed_first_line",
        "normalized_version_output_sha256", "normalized_version_output_size_bytes", "normalization_policy"
      ],
      "properties": {
        "id": {
          "enum": ["bash", "curl", "dart", "docker", "flutter", "java", "javac", "javap", "maven", "node", "pnpm", "python", "rg", "ruby", "uv"]
        },
        "version_argv": { "$ref": "#/$defs/argv" },
        "status": { "enum": ["observed", "failed"] },
        "timed_out": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"], "minimum": 0 },
        "observed_first_line": { "type": "string" },
        "normalized_version_output_sha256": { "$ref": "#/$defs/sha256" },
        "normalized_version_output_size_bytes": { "type": "integer", "minimum": 0 },
        "normalization_policy": { "type": "string", "minLength": 1 },
        "failure_class": { "type": "string", "minLength": 1 }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "mode"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string", "pattern": "^[0-7]{4}$" }
      }
    },
    "stable_observations": {
      "type": "object", "additionalProperties": false,
      "required": [
        "normalized_stdout_sha256", "normalized_stderr_sha256",
        "normalized_diagnostic_set_sha256", "repeat_normalized_diagnostic_set_sha256"
      ],
      "properties": {
        "normalized_stdout_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "normalized_stderr_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "normalized_diagnostic_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "repeat_normalized_diagnostic_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "output_closure": {
      "type": "object", "additionalProperties": false,
      "required": [
        "first_status", "repeat_status", "first_generated_output_count",
        "repeat_generated_output_count", "first_generated_output_set_sha256",
        "repeat_generated_output_set_sha256", "first_generated_output_sha256",
        "repeat_generated_output_sha256"
      ],
      "properties": {
        "first_status": { "enum": ["closed", "failed", "unavailable"] },
        "repeat_status": { "enum": ["closed", "failed", "unavailable"] },
        "first_generated_output_count": { "type": "integer", "minimum": 0 },
        "repeat_generated_output_count": { "type": "integer", "minimum": 0 },
        "first_generated_output_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "repeat_generated_output_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "first_generated_output_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "repeat_generated_output_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": [
        "role", "verify_path", "verify_sha256", "verify_mode", "shebang",
        "suggested_expected_exit_code_unreviewed", "command", "input_count",
        "static_input_closure_policy", "input_set_sha256", "inputs", "tool_hints", "observation_status",
        "observed_exact_exit_code", "repeat_exact_exit_code", "observed_run_count",
        "expected_red_marker_present", "stable_observations", "output_closure",
        "two_fresh_copy_runs_consistent", "tool_probes"
      ],
      "properties": {
        "role": { "enum": ["example", "exercise", "lab"] },
        "verify_path": { "type": "string", "minLength": 1 },
        "verify_sha256": { "$ref": "#/$defs/sha256" },
        "verify_mode": { "const": "0755" },
        "shebang": { "type": "string", "minLength": 1 },
        "suggested_expected_exit_code_unreviewed": { "type": "integer", "minimum": 0 },
        "command": { "$ref": "#/$defs/argv" },
        "static_input_closure_policy": { "type": "string", "minLength": 1 },
        "input_count": { "type": "integer", "minimum": 1 },
        "input_set_sha256": { "$ref": "#/$defs/sha256" },
        "inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/input" } },
        "tool_hints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "observation_status": { "enum": ["passed", "failed"] },
        "observed_exact_exit_code": { "type": ["integer", "null"], "minimum": 0 },
        "repeat_exact_exit_code": { "type": ["integer", "null"], "minimum": 0 },
        "observed_run_count": { "type": "integer", "minimum": 0 },
        "expected_red_marker_present": { "type": "boolean" },
        "stable_observations": { "$ref": "#/$defs/stable_observations" },
        "output_closure": { "$ref": "#/$defs/output_closure" },
        "two_fresh_copy_runs_consistent": { "type": "boolean" },
        "tool_probes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/tool_probe" } }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["chapter_id", "status", "endpoints", "review_required"],
      "properties": {
        "chapter_id": { "$ref": "#/$defs/chapter_id" },
        "status": {
          "enum": ["observed-unreviewed-candidate-v2", "observed-unreviewed-candidate-v2-with-mechanical-gaps"]
        },
        "endpoints": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "review_required": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
