{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/version-registry.schema.json",
  "title": "FactoryCare encyclopedia version registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "edition", "verified_at", "policy", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_id": { "const": "factorycare-version-registry" },
    "edition": { "type": "string", "minLength": 1 },
    "verified_at": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_only", "patch_resolution", "recheck_before_use"],
      "properties": {
        "stable_only": { "type": "boolean" },
        "patch_resolution": { "enum": ["at-chapter-verification", "locked"] },
        "recheck_before_use": { "type": "boolean" }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "constraint", "channel", "status", "verified_at", "source_url", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["runtime", "language", "framework", "library", "tool", "platform", "protocol", "standard", "service"]
          },
          "constraint": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "provisional", "conceptual"] },
          "verified_at": { "type": "string", "format": "date" },
          "source_url": {
            "type": "string",
            "pattern": "^https://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
          },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
