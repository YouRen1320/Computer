{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/exercise-contract-audit.schema.json",
  "title": "FactoryCare observed exercise contract audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "generated_by", "status", "evidence_class",
    "promotion_status", "source_endpoint_report_sha256", "chapter_count", "run_count", "fresh_copy_runs_per_chapter",
    "mechanical_failure_count", "mechanical_failure_ids",
    "expected_red_marker_present_count", "expected_red_marker_missing_count",
    "expected_red_marker_missing_ids", "observed_exit_code_distribution",
    "nonstandard_exit_41_count", "nonstandard_exit_41_ids",
    "safe_standardization_candidate_count", "safe_standardization_candidate_ids",
    "boundary", "results"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_id": { "const": "p9-exercise-contract-observations" },
    "generated_by": { "const": "scripts/audit-exercise-contracts.rb" },
    "status": { "enum": ["observed-unreviewed", "mechanical-failures-observed"] },
    "evidence_class": { "const": "machine-only-not-learner-evidence" },
    "promotion_status": { "const": "forbidden-without-human-review" },
    "source_endpoint_report_sha256": { "$ref": "#/$defs/sha256" },
    "chapter_count": { "const": 255 },
    "run_count": { "type": "integer", "minimum": 0 },
    "fresh_copy_runs_per_chapter": { "const": 2 },
    "mechanical_failure_count": { "type": "integer", "minimum": 0 },
    "mechanical_failure_ids": { "$ref": "#/$defs/chapter_ids" },
    "expected_red_marker_present_count": { "type": "integer", "minimum": 0 },
    "expected_red_marker_missing_count": { "type": "integer", "minimum": 0 },
    "expected_red_marker_missing_ids": { "$ref": "#/$defs/chapter_ids" },
    "observed_exit_code_distribution": {
      "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "nonstandard_exit_41_count": { "type": "integer", "minimum": 0 },
    "nonstandard_exit_41_ids": { "$ref": "#/$defs/chapter_ids" },
    "safe_standardization_candidate_count": { "type": "integer", "minimum": 0 },
    "safe_standardization_candidate_ids": { "$ref": "#/$defs/chapter_ids" },
    "boundary": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array", "minItems": 255, "maxItems": 255, "uniqueItems": true,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chapter_id": { "type": "string", "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "chapter_ids": {
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/chapter_id" }
    },
    "output_closure": {
      "type": "object", "additionalProperties": false,
      "required": [
        "first_status", "repeat_status", "first_generated_output_count",
        "repeat_generated_output_count", "first_generated_output_set_sha256",
        "repeat_generated_output_set_sha256", "first_generated_output_sha256",
        "repeat_generated_output_sha256"
      ],
      "properties": {
        "first_status": { "enum": ["closed", "failed", "unavailable"] },
        "repeat_status": { "enum": ["closed", "failed", "unavailable"] },
        "first_generated_output_count": { "type": "integer", "minimum": 0 },
        "repeat_generated_output_count": { "type": "integer", "minimum": 0 },
        "first_generated_output_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "repeat_generated_output_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "first_generated_output_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "repeat_generated_output_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "chapter_id", "mechanical_status", "command", "observed_exact_exit_code",
        "repeat_exact_exit_code", "observed_run_count", "timed_out",
        "expected_red_marker_present", "expected_red_marker_first_run",
        "expected_red_marker_repeat_run", "normalized_diagnostic_set_sha256",
        "repeat_normalized_diagnostic_set_sha256", "output_closure", "fresh_copy_consistent"
      ],
      "properties": {
        "chapter_id": { "$ref": "#/$defs/chapter_id" },
        "mechanical_status": { "enum": ["passed", "failed"] },
        "command": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "observed_exact_exit_code": { "type": ["integer", "null"], "minimum": 0 },
        "repeat_exact_exit_code": { "type": ["integer", "null"], "minimum": 0 },
        "observed_run_count": { "type": "integer", "minimum": 0 },
        "timed_out": { "type": "boolean" },
        "expected_red_marker_present": { "type": "boolean" },
        "expected_red_marker_first_run": { "type": "boolean" },
        "expected_red_marker_repeat_run": { "type": "boolean" },
        "normalized_diagnostic_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "repeat_normalized_diagnostic_set_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "output_closure": { "$ref": "#/$defs/output_closure" },
        "fresh_copy_consistent": { "type": "boolean" }
      }
    }
  }
}
