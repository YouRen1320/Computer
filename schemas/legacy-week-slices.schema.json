{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/legacy-week-slices.schema.json",
  "title": "FactoryCare Week 00-48 outcome-slice compatibility route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_edition",
    "target_edition",
    "policy",
    "rollback_tag",
    "outcome_ref_format",
    "section_roles",
    "budget_policy",
    "mastery_policy",
    "weeks"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "source_edition": { "type": "string", "minLength": 1 },
    "target_edition": { "type": "string", "minLength": 1 },
    "policy": { "const": "outcome-slice-adapter" },
    "rollback_tag": { "type": "string", "minLength": 1 },
    "outcome_ref_format": { "const": "chapter-id#outcome-id" },
    "section_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "practice_diagnosis", "review", "support"],
      "properties": {
        "required": { "const": "primary" },
        "practice_diagnosis": { "const": "primary" },
        "review": { "const": "refresh" },
        "support": { "const": "support" }
      }
    },
    "budget_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "week_00", "standard_weeks", "section_keys"],
      "properties": {
        "unit": { "const": "hour" },
        "week_00": { "$ref": "#/$defs/budget_range" },
        "standard_weeks": { "$ref": "#/$defs/budget_range" },
        "section_keys": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["required", "practice_diagnosis", "review", "support"] }
        }
      }
    },
    "mastery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_depth_source",
        "route_required_mastery_field",
        "profiles",
        "required_assignments"
      ],
      "properties": {
        "reference_depth_source": { "const": "curriculum/catalog.yml#/chapters/*/level" },
        "route_required_mastery_field": { "const": "required_mastery" },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["L1-L2", "L2", "L2+", "L3"],
          "properties": {
            "L1-L2": { "$ref": "#/$defs/evidence_list" },
            "L2": { "$ref": "#/$defs/evidence_list" },
            "L2+": { "$ref": "#/$defs/evidence_list" },
            "L3": { "$ref": "#/$defs/evidence_list" }
          }
        },
        "required_assignments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["machine_learning", "artificial_intelligence"],
          "properties": {
            "machine_learning": { "$ref": "#/$defs/mastery_assignment" },
            "artificial_intelligence": { "$ref": "#/$defs/mastery_assignment" }
          }
        }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "items": { "$ref": "#/$defs/week" }
    }
  },
  "$defs": {
    "budget_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "mastery_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weeks", "required_mastery"],
      "properties": {
        "weeks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "required_mastery": { "enum": ["L1-L2", "L2", "L2+", "L3"] }
      }
    },
    "outcome_ref": {
      "type": "string",
      "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*#(?:explain|build|diagnose)$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "target", "maximum", "allocation"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1 },
        "target": { "type": "integer", "minimum": 1 },
        "maximum": { "type": "integer", "minimum": 1 },
        "allocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "practice_diagnosis", "review", "support"],
          "properties": {
            "required": { "type": "integer", "minimum": 0 },
            "practice_diagnosis": { "type": "integer", "minimum": 0 },
            "review": { "type": "integer", "minimum": 0 },
            "support": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "week",
        "title",
        "progress_theme",
        "budget_hours",
        "required_mastery",
        "evidence_requirements",
        "required",
        "practice_diagnosis",
        "review",
        "support"
      ],
      "properties": {
        "week": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "progress_theme": { "type": "string", "minLength": 1 },
        "budget_hours": { "$ref": "#/$defs/budget" },
        "required_mastery": { "enum": ["L1-L2", "L2", "L2+", "L3"] },
        "evidence_requirements": { "$ref": "#/$defs/evidence_list" },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outcome_ref" }
        },
        "practice_diagnosis": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outcome_ref" }
        },
        "review": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outcome_ref" }
        },
        "support": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/outcome_ref" }
        }
      }
    }
  }
}
