{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/encyclopedia-definition-of-done.schema.json",
  "title": "FactoryCare encyclopedia chapter definition-of-done audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "generated_by", "status", "evidence_classification",
    "catalog", "chapter_total", "review_batch_policy", "review_batches",
    "check_catalog", "state_counts", "structurally_ready_count",
    "semantic_approval_count", "chapters", "source_set"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "audit_id": { "const": "p9-encyclopedia-definition-of-done" },
    "generated_by": { "const": "scripts/audit-encyclopedia-definition-of-done.rb" },
    "status": {
      "enum": ["incomplete", "structurally-ready-human-review-required", "semantically-approved"]
    },
    "evidence_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "promotion", "boundary"],
      "properties": {
        "class": { "const": "machine-structural-inventory" },
        "promotion": { "const": "forbidden-without-human-review" },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "catalog": { "$ref": "#/$defs/evidence" },
    "chapter_total": { "const": 255 },
    "review_batch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_chapters", "maximum_chapters", "batch_count", "assignment"],
      "properties": {
        "minimum_chapters": { "const": 5 },
        "maximum_chapters": { "const": 8 },
        "batch_count": { "type": "integer", "minimum": 1 },
        "assignment": { "const": "catalog-order-balanced-deterministic" }
      }
    },
    "review_batches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/review_batch" }
    },
    "check_catalog": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/check_definition" }
    },
    "state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "missing", "human-review-required", "not-applicable"],
      "properties": {
        "present": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "human-review-required": { "type": "integer", "minimum": 0 },
        "not-applicable": { "type": "integer", "minimum": 0 }
      }
    },
    "structurally_ready_count": { "type": "integer", "minimum": 0 },
    "semantic_approval_count": { "type": "integer", "minimum": 0 },
    "chapters": {
      "type": "array",
      "minItems": 255,
      "maxItems": 255,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/chapter" }
    },
    "source_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "source_count", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256-path-nul-bytes-nul-v1" },
        "source_count": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(?:/[a-zA-Z0-9_][a-zA-Z0-9._-]*)*$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "review_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^batch-[0-9]{2}$" },
        "chapter_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/chapter_id" }
        }
      }
    },
    "check_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "class": { "enum": ["structural", "human-review"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "state", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "class": { "enum": ["structural", "human-review"] },
        "state": { "enum": ["present", "missing", "human-review-required", "not-applicable"] },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": { "enum": ["missing", "human-review-required", "not-applicable"] }
            }
          },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id", "volume", "order", "review_batch_id",
        "structural_status", "semantic_status", "checks"
      ],
      "properties": {
        "chapter_id": { "$ref": "#/$defs/chapter_id" },
        "volume": { "type": "string", "pattern": "^[0-9]{2}$" },
        "order": { "type": "integer", "minimum": 1 },
        "review_batch_id": { "type": "string", "pattern": "^batch-[0-9]{2}$" },
        "structural_status": { "enum": ["ready-for-human-review", "incomplete"] },
        "semantic_status": { "enum": ["human-review-required", "approved"] },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/check" }
        }
      }
    }
  }
}
