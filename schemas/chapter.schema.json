{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.local/schemas/chapter.schema.json",
  "title": "FactoryCare encyclopedia chapter front matter v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition",
    "id",
    "title",
    "responsibility",
    "volume",
    "order",
    "level",
    "status",
    "path",
    "catalog",
    "prerequisites",
    "version_surfaces",
    "route_tags"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "edition": { "type": "string", "minLength": 1 },
    "id": { "$ref": "#/$defs/chapter_id" },
    "title": { "type": "string", "minLength": 1 },
    "responsibility": { "type": "string", "minLength": 12 },
    "volume": { "type": "string", "pattern": "^[0-9]{2}$" },
    "order": { "type": "integer", "minimum": 1 },
    "level": {
      "description": "Encyclopedia reference depth. Route exit mastery is declared separately as required_mastery and does not truncate this chapter's reference content.",
      "enum": ["L1", "L2", "L2+", "L3", "L1-L2"]
    },
    "status": { "enum": ["planned", "drafting", "review", "verified"] },
    "path": {
      "type": "string",
      "pattern": "^book/volume-[0-9]{2}-[a-z0-9-]+/chapters/ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
    },
    "catalog": { "const": "../../../curriculum/catalog.yml" },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/chapter_id" }
    },
    "version_surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
    },
    "route_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "stable_core": { "type": "boolean" },
    "outcomes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "generated_by": { "const": "scripts/generate-curriculum.rb" },
    "generated_spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verified_versions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "constraint", "verified_at", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "constraint": { "type": "string", "minLength": 1 },
          "verified_at": { "type": "string", "format": "date" },
          "evidence": { "$ref": "#/$defs/evidence_path" }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "kind", "checked_at", "supports"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "url": {
            "type": "string",
            "pattern": "^https://[^/?#@\\s]+(?:[/?#][^\\s]*)?$"
          },
          "kind": {
            "enum": ["official-doc", "specification", "standard", "research", "book", "source-repository", "other"]
          },
          "checked_at": { "type": "string", "format": "date" },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/example_path" }
    },
    "labs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lab_path" }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/exercise_path" }
    },
    "solutions_private": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/solution_path" }
    },
    "author": { "type": "string", "minLength": 2 },
    "last_reviewed": { "type": "string", "format": "date" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical",
        "pedagogical",
        "code",
        "security",
        "accessibility",
        "version_sources",
        "publication_navigation"
      ],
      "properties": {
        "technical": { "$ref": "#/$defs/gate" },
        "pedagogical": { "$ref": "#/$defs/gate" },
        "code": { "$ref": "#/$defs/gate" },
        "security": { "$ref": "#/$defs/gate" },
        "accessibility": { "$ref": "#/$defs/gate" },
        "version_sources": { "$ref": "#/$defs/gate" },
        "publication_navigation": { "$ref": "#/$defs/publication_gate" }
      }
    }
  },
  "$defs": {
    "chapter_id": {
      "type": "string",
      "pattern": "^ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "covers_topic_groups",
        "covers_topics",
        "uses_capabilities",
        "evidence_kind",
        "verification_mode"
      ],
      "properties": {
        "id": { "enum": ["explain", "build", "diagnose"] },
        "kind": { "enum": ["concept", "independent-build", "fault-diagnosis"] },
        "text": { "type": "string", "minLength": 20 },
        "covers_topic_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "covers_topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
        },
        "uses_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" }
        },
        "evidence_kind": { "type": "string", "minLength": 1 },
        "verification_mode": { "type": "string", "minLength": 1 }
      }
    },
    "example_path": {
      "type": "string",
      "pattern": "^examples/encyclopedia/ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-zA-Z0-9._/-]+)?$"
    },
    "lab_path": {
      "type": "string",
      "pattern": "^labs/encyclopedia/ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-zA-Z0-9._/-]+)?$"
    },
    "exercise_path": {
      "type": "string",
      "pattern": "^exercises/encyclopedia/ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-zA-Z0-9._/-]+)?$"
    },
    "solution_path": {
      "type": "string",
      "pattern": "^solutions-private/encyclopedia/ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-zA-Z0-9._/-]+)?$"
    },
    "evidence_path": {
      "type": "string",
      "pattern": "^records/encyclopedia/evidence/ch\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*/[a-zA-Z0-9._/-]+$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "checked_at", "reviewer"],
      "properties": {
        "status": { "enum": ["pending", "passed", "not-applicable"] },
        "evidence": { "$ref": "#/$defs/evidence_list" },
        "checked_at": { "type": "string", "format": "date" },
        "reviewer": { "type": "string", "minLength": 2 },
        "applicability_reason": { "type": "string", "minLength": 10 }
      }
    },
    "publication_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "checked_at", "reviewer", "coverage"],
      "properties": {
        "status": { "enum": ["pending", "passed", "not-applicable"] },
        "evidence": { "$ref": "#/$defs/evidence_list" },
        "checked_at": { "type": "string", "format": "date" },
        "reviewer": { "type": "string", "minLength": 2 },
        "applicability_reason": { "type": "string", "minLength": 10 },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["links", "keyboard_semantics", "rendering"],
          "properties": {
            "links": { "$ref": "#/$defs/publication_check" },
            "keyboard_semantics": { "$ref": "#/$defs/publication_check" },
            "rendering": { "$ref": "#/$defs/publication_check" }
          }
        }
      }
    },
    "publication_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["pending", "passed", "not-applicable"] },
        "evidence": { "$ref": "#/$defs/evidence_list" },
        "applicability_reason": { "type": "string", "minLength": 10 }
      }
    },
    "evidence_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidence_path" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "planned" } } },
      "then": { "required": ["generated_by", "generated_spec_digest"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["drafting", "review", "verified"] } } },
      "then": { "required": ["stable_core", "outcomes"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["review", "verified"] } } },
      "then": {
        "required": [
          "verified_versions",
          "source_refs",
          "examples",
          "labs",
          "exercises",
          "solutions_private",
          "author",
          "last_reviewed",
          "verification"
        ]
      }
    }
  ]
}
