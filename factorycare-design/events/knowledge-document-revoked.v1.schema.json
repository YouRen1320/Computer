{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.example.test/schemas/events/knowledge-document-revoked.v1.schema.json",
  "title": "KnowledgeDocumentRevoked.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["eventId", "eventType", "version", "occurredAt", "tenantId", "aggregateId", "traceId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "KnowledgeDocumentRevoked.v1" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string", "minLength": 16, "maxLength": 64 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["versionId", "versionNumber", "reason", "revokedByMembershipId", "revokedAt"],
      "properties": {
        "versionId": { "type": "string", "format": "uuid" },
        "versionNumber": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "revokedByMembershipId": { "type": "string", "format": "uuid" },
        "revokedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
