{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.example.test/schemas/events/work-order-assigned.v1.schema.json",
  "title": "WorkOrderAssigned.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["eventId", "eventType", "version", "occurredAt", "tenantId", "aggregateId", "traceId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "WorkOrderAssigned.v1" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string", "minLength": 16, "maxLength": 64 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["teamId", "technicianMembershipId", "assignedByMembershipId", "assignmentId", "aggregateVersion", "assignedAt"],
      "properties": {
        "teamId": { "type": "string", "format": "uuid" },
        "technicianMembershipId": { "type": "string", "format": "uuid" },
        "assignedByMembershipId": { "type": "string", "format": "uuid" },
        "assignmentId": { "type": "string", "format": "uuid" },
        "replacesAssignmentId": { "type": ["string", "null"], "format": "uuid" },
        "aggregateVersion": { "type": "integer", "minimum": 1 },
        "assignedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
