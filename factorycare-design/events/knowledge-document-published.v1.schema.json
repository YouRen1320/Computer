{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorycare.example.test/schemas/events/knowledge-document-published.v1.schema.json",
  "title": "KnowledgeDocumentPublished.v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["eventId", "eventType", "version", "occurredAt", "tenantId", "aggregateId", "traceId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "KnowledgeDocumentPublished.v1" },
    "version": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "tenantId": { "type": "string", "format": "uuid" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "traceId": { "type": "string", "minLength": 16, "maxLength": 64 },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["versionId", "versionNumber", "publishedByMembershipId", "objectKey", "sha256", "mime", "visibility", "acl", "publishedAt"],
      "properties": {
        "versionId": { "type": "string", "format": "uuid" },
        "versionNumber": { "type": "integer", "minimum": 1 },
        "publishedByMembershipId": { "type": "string", "format": "uuid" },
        "objectKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mime": { "type": "string", "maxLength": 200 },
        "equipmentModelId": { "type": ["string", "null"], "format": "uuid" },
        "visibility": { "enum": ["TENANT", "ORGANIZATION", "TEAM"] },
        "acl": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 200 } },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
