# Synthetic fixture: digest values demonstrate the contract and are not pullable identities.
FROM eclipse-temurin:25-jdk@sha256:1111111111111111111111111111111111111111111111111111111111111111 AS build
WORKDIR /src
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN ./mvnw -B -DskipTests dependency:go-offline
COPY src/ src/
RUN ./mvnw -B package

FROM eclipse-temurin:25-jre@sha256:2222222222222222222222222222222222222222222222222222222222222222 AS runtime
WORKDIR /app
COPY --from=build /src/target/factorycare.jar /app/factorycare.jar
USER 10001:10001
STOPSIGNAL SIGTERM
ENTRYPOINT ["java","-jar","/app/factorycare.jar"]
