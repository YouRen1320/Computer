  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "isolatedModules": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM"], "types": ["vitest/globals"]
